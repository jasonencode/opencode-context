{
  "name": "@jasonencode/opencode-context",
  "version": "0.1.1",
  "description": "Context window usage for the OpenCode sidebar",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "tui.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "test": "node --test test/context.test.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonencode/opencode-context.git"
  },
  "homepage": "https://github.com/jasonencode/opencode-context#readme",
  "bugs": {
    "url": "https://github.com/jasonencode/opencode-context/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "context",
    "tokens",
    "tui"
  ],
  "license": "MIT",
  "author": "jasonencode",
  "devDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@opentui/core": "^0.6.8",
    "@opentui/solid": "^0.6.8",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "1.9.12",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3.0.0",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
