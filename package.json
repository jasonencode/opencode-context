{
  "name": "@jasonencode/opencode-context",
  "version": "1.1.0",
  "description": "Context window usage, token analytics & performance dashboard for the OpenCode sidebar",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "tui.ts"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc && node build.tui.mjs",
    "test": "node --test test/context.test.mjs test/session-timing.test.mjs test/adapter.test.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonencode/opencode-context.git"
  },
  "homepage": "https://github.com/jasonencode/opencode-context#readme",
  "bugs": {
    "url": "https://github.com/jasonencode/opencode-context/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "context",
    "tokens",
    "usage",
    "stats",
    "cache",
    "analytics",
    "tui"
  ],
  "license": "MIT",
  "author": "jasonencode",
  "contributors": [
    "TTWK"
  ],
  "devDependencies": {
    "@opencode/plugin": "^2.3.2",
    "@opentui/core": "^0.9.2",
    "@opentui/solid": "^0.9.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.19",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.2 <3.0.0",
    "@opentui/core": ">=0.9.2 <0.10.0",
    "@opentui/solid": ">=0.9.2 <0.10.0",
    "solid-js": ">=1.9.12 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
